rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Single-user / per-user multi-device sync scoped under the
    // authenticated Firebase Auth UID (Google Sign-In with verified email).
    //
    // Collection: /users/{userId}/sync
    // Document ID: 'settings' (fixed singleton per user)
    // Fields:
    //   - data: map (required, allowed keys only) - serialized GymApp Settings
    //       Optional typed/bounded subfields inside data:
    //       - routines: map (1..20 entries, dynamic user-defined routine names)
    //       - routineMeta: map (optional, size <= 20)
    //       - profile: map (keys in ['sex', 'age', 'height', 'goal', 'experience', 'daysPerWeek']; sex string <= 64, age 0..150, height 0..300, goal optional in ['bulk', 'cut', 'recomp', 'strength'], experience optional in ['beginner', 'intermediate', 'advanced'], daysPerWeek optional number 1..7)
    //       - customNames: map (size <= 500)
    //       - refNames: map (size <= 500)
    //       - aliases: map (size <= 500)
    //       - muscles: map (size <= 500)
    //       - notes: map (size <= 500)
    //       - hiddenExercises: list (optional, size <= 500)
    //       - phases: list (size <= 100)
    //       - onboardingCompleted: bool (optional)
    //       - geminiKey: string (size <= 256, optional legacy field)
    //       - aiTone: string (optional, in ['simple', 'technical'])
    //       - ai: map (keys in ['date', 'tone', 'summary', 'overview', 'byExercise']; tone optional in ['simple', 'technical'])
    //       - theme: string (optional, in ['dark', 'light', 'system'])
    //   - updatedAt: number (required, 0 <= val <= request.time + 24h) - client epoch ms
    //   - wipedAt: number (optional, 0 <= val <= request.time + 24h) - client epoch ms of cloud wipe
    //
    // Collection: /users/{userId}/buckets
    // Document ID: '<kind>_<suffix>' matching ^(strength|cardio|measures|wellbeing)_[a-z0-9]{2,16}$
    // Fields:
    //   - kind: string (required, immutable on update, in ['strength', 'cardio', 'measures', 'wellbeing'], matches bucketId prefix)
    //   - items: map (required, size <= 5000) - keyed record map
    //   - deleted: map (optional, size <= 5000) - keyed tombstone timestamps
    //   - updatedAt: number (required, 0 <= val <= request.time + 24h) - client epoch ms
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request comes from an authenticated user with a verified email (GoogleAuthProvider)
    function isAuthenticated() {
      return request.auth != null
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    // Check if the authenticated user owns the target userId path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate required top-level fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate document contains only allowed top-level fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate immutable fields did not change on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate finite non-negative epoch ms timestamp within 24h future clock-skew tolerance
    function isValidEpochMs(val) {
      return val is number
        && val >= 0
        && val <= request.time.toMillis() + 86400000;
    }

    function isOptionalMapMax(obj, key, maxSize) {
      return !(key in obj) || (obj[key] is map && obj[key].size() <= maxSize);
    }

    function isOptionalListMax(obj, key, maxSize) {
      return !(key in obj) || (obj[key] is list && obj[key].size() <= maxSize);
    }

    function isOptionalStringMax(obj, key, maxLen) {
      return !(key in obj) || (obj[key] is string && obj[key].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProfile(p) {
      return p is map
        && p.keys().hasOnly(['sex', 'age', 'height', 'goal', 'experience', 'daysPerWeek'])
        && isOptionalStringMax(p, 'sex', 64)
        && (!('age' in p) || (p.age is number && p.age >= 0 && p.age <= 150))
        && (!('height' in p) || (p.height is number && p.height >= 0 && p.height <= 300))
        && (!('goal' in p) || (p.goal is string && p.goal in ['bulk', 'cut', 'recomp', 'strength']))
        && (!('experience' in p) || (p.experience is string && p.experience in ['beginner', 'intermediate', 'advanced']))
        && (!('daysPerWeek' in p) || (p.daysPerWeek is number && p.daysPerWeek >= 1 && p.daysPerWeek <= 7));
    }

    function isValidRoutines(r) {
      return r is map
        && r.size() >= 1
        && r.size() <= 20;
    }

    function isValidAiResult(a) {
      return a is map
        && a.keys().hasOnly(['date', 'tone', 'summary', 'overview', 'byExercise'])
        && isOptionalStringMax(a, 'date', 32)
        && (!('tone' in a) || (a.tone is string && a.tone in ['simple', 'technical']))
        && (!('summary' in a) || a.summary == null || (a.summary is string && a.summary.size() <= 20000))
        && (!('overview' in a) || a.overview == null || (a.overview is map && a.overview.size() <= 20))
        && isOptionalMapMax(a, 'byExercise', 500);
    }

    function isValidSettingsPayload(d) {
      return d is map
        && d.keys().hasOnly([
          'routines', 'routineMeta', 'profile', 'customNames', 'refNames',
          'aliases', 'muscles', 'notes', 'hiddenExercises', 'phases',
          'onboardingCompleted', 'geminiKey', 'aiTone', 'ai', 'theme'
        ])
        && (!('routines' in d) || isValidRoutines(d.routines))
        && isOptionalMapMax(d, 'routineMeta', 20)
        && (!('profile' in d) || isValidProfile(d.profile))
        && isOptionalMapMax(d, 'customNames', 500)
        && isOptionalMapMax(d, 'refNames', 500)
        && isOptionalMapMax(d, 'aliases', 500)
        && isOptionalMapMax(d, 'muscles', 500)
        && isOptionalMapMax(d, 'notes', 500)
        && isOptionalListMax(d, 'hiddenExercises', 500)
        && isOptionalListMax(d, 'phases', 100)
        && (!('onboardingCompleted' in d) || d.onboardingCompleted is bool)
        && isOptionalStringMax(d, 'geminiKey', 256)
        && (!('aiTone' in d) || (d.aiTone is string && d.aiTone in ['simple', 'technical']))
        && (!('ai' in d) || isValidAiResult(d.ai))
        && (!('theme' in d) || (d.theme is string && d.theme in ['dark', 'light', 'system']));
    }

    function isValidSyncSettings(docData) {
      return hasRequiredFields(['data', 'updatedAt'])
        && hasOnlyAllowedFields(['data', 'updatedAt', 'wipedAt'])
        && isValidSettingsPayload(docData.data)
        && isValidEpochMs(docData.updatedAt)
        && (!('wipedAt' in docData) || isValidEpochMs(docData.wipedAt));
    }

    function isValidBucketId(bucketId) {
      return bucketId.matches('^(strength|cardio|measures|wellbeing)_[a-z0-9]{2,16}$');
    }

    function isValidBucket(bucketId, docData) {
      return hasRequiredFields(['kind', 'items', 'updatedAt'])
        && hasOnlyAllowedFields(['kind', 'items', 'deleted', 'updatedAt'])
        && docData.kind is string
        && docData.kind in ['strength', 'cardio', 'measures', 'wellbeing']
        && bucketId.matches('^' + docData.kind + '_[a-z0-9]{2,16}$')
        && docData.items is map
        && docData.items.size() <= 5000
        && isOptionalMapMax(docData, 'deleted', 5000)
        && isValidEpochMs(docData.updatedAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId}/sync/{docId} {
      allow read, delete: if isOwner(userId) && docId == 'settings';
      allow create, update: if isOwner(userId)
        && docId == 'settings'
        && isValidSyncSettings(request.resource.data);
    }

    match /users/{userId}/buckets/{bucketId} {
      // Split get/list so getDocs(collection(fs, 'users', uid, 'buckets')) is statically authorized for the owner
      allow get, delete: if isOwner(userId) && isValidBucketId(bucketId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidBucketId(bucketId)
        && isValidBucket(bucketId, request.resource.data);
      allow update: if isOwner(userId)
        && isValidBucketId(bucketId)
        && isValidBucket(bucketId, request.resource.data)
        && areImmutableFieldsUnchanged(['kind']);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
